<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %} — MotoRide-Connect</title>
        <meta name="description" content="{% block metaDescription %}Organisez et rejoignez des balades moto entre passionnés.{% endblock %}">
        <link rel="icon" href="{{ asset('images/favicon.svg') }}">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Enveloppe sans boite sur mobile : elle ne sert qu'a aligner la barre haute sur grand ecran #}
        <div class="topbar-shell">
            {% block header %}{{ include('_header.html.twig', {}, with_context = false) }}{% endblock %}

            {% block nav %}{{ include('_tabbar.html.twig') }}{% endblock %}

            {# Doublon assume du tiroir : un seul des deux jeux est affiche a la fois #}
            <nav class="topbar-links" aria-label="Menu secondaire">
                {{ include('_menu.html.twig', {}, with_context = false) }}
            </nav>
        </div>

        <main class="page">
            <div data-turbo-temporary>
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {# Une erreur est annoncee tout de suite, un succes attend une pause #}
                        <div class="flash-{{ label }}" role="{{ label == 'danger' ? 'alert' : 'status' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>

            {% block body %}{% endblock %}
        </main>

        {# Reserve de fin : la barre est fixe, sans elle elle masquerait le dernier contenu #}
        {% block footer %}{% if app.user %}<div class="tabbar-spacer"></div>{% endif %}{% endblock %}
    </body>
</html>
