{% if pagination.totalPages > 1 %}
    <nav class="pagination" aria-label="Pagination">
        {% if pagination.hasPrevious %}
            <a class="btn btn-secondary" href="{{ path('app_ride', app.request.query.all|merge({page: pagination.previousPage})) }}">Précédent</a>
        {% endif %}

        <span class="mono text-muted">Page {{ pagination.currentPage }} sur {{ pagination.totalPages }}</span>

        {% if pagination.hasNext %}
            <a class="btn btn-secondary" href="{{ path('app_ride', app.request.query.all|merge({page: pagination.nextPage})) }}">Suivant</a>
        {% endif %}
    </nav>
{% endif %}
