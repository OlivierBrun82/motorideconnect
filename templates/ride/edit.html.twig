{% extends 'base.html.twig' %}

{% block title %} Modifier ta balade {% endblock %}

{% block body %}
        <h1>Modifier ta balade</h1>

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Modifier</button> <br>
        {{ form_end(form) }}
        <form method="post" action="{{ path('app_ride_delete', {id: ride.id}) }}"
            onsubmit="return confirm('Supprimer cette balade ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ride.id) }}">
            <button type="submit">Supprimer</button>
        </form>
{% endblock %}