{# Pastille de statut : le remplissage et la graisse portent l'etat, jamais la teinte #}
{% if ride.statut.value == 'canceled' %}
    <span class="pill pill-canceled">Annulée</span>
{% elseif ride.meetingDatetime < date() %}
    <span class="pill pill-completed">Terminée</span>
{% else %}
    <span class="pill pill-{{ ride.statut.value }}">{{ ride.statut.label }}</span>
{% endif %}
