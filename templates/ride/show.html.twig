{% extends 'base.html.twig' %}

{% block title %} {{ ride.name }} {% endblock %}

{% block body %}
    <h1>{{ ride.name }}</h1> <br>

    Statut : {{ include('ride/_status.html.twig', {ride: ride}) }} <br>
    Nombre d'inscrit : {{ ride.participants|length}} <br>
    Places restantes : {{ ride.capacity - (ride.participants|length) }} / {{ ride.capacity }} <br>
    Description : <p>{{ ride.descriptionMessage}}</p> <br>
    Lieu de RDV : {{ ride.meetingPlace}} <br>
    Date : {{ ride.meetingDatetime|date('d/m/Y H:i')}} <br>
    Rhytme : {{ride.rideType.label}} <br>
    Niveau Conseillé: {{ride.pilotLevel.label}} <br>
    {% for moto in ride.motorcycles %}
        Moto de {{ moto.user.pseudo }} : {{ moto.brand.name ?? '' }} {{ moto.type.label }} ({{ moto.displacement }} cm³){% if not loop.last %}, {% endif %}
    {% else %}
        Aucune
    {% endfor %}
    <br>
    
    {{ include('ride/_participation.html.twig', {ride: ride}) }}
    {{ include('ride/_like.html.twig', {ride: ride}) }}

<h2>Commentaires</h2>

{% for comment in ride.comments %}
    <div>
        <strong>{{ comment.user.pseudo }}</strong>
        <em>{{ comment.createdAt|date('d/m/Y H:i') }}</em>
        <p>{{ comment.message }}</p>

        {# bouton supprimer : auteur OU organisateur de la balade #}
        {% if comment.user == app.user or ride.user == app.user %}
            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}"
                  onsubmit="return confirm('Supprimer ce commentaire ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ comment.id) }}">
                <button type="submit">Supprimer</button>
            </form>
        {% endif %}
    </div>
{% else %}
    <p>Aucun commentaire pour l'instant.</p>
{% endfor %}

{% if ride.participants.contains(app.user)
      and ride.statut.value != 'canceled'
      and ride.meetingDatetime > date() %}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Publier</button>
    {{ form_end(form) }}
{% endif %}
    
    <a href="{{ path('app_home') }}">Accueil</a>
{% endblock %}