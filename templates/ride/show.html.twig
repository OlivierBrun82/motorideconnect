{% extends 'base.html.twig' %}

{% block title %} {{ ride.name }} {% endblock %}

{% block body %}
    <h1>{{ ride.name }}</h1> <br>

    Statut : {{ include('ride/_status.html.twig', {ride: ride}) }} <br>
    Nombre d'inscrit : {{ ride.participants|length}} <br>
    Places restantes : {{ ride.capacity - (ride.participants|length) }} / {{ ride.capacity }} <br>
    Description : <p>{{ ride.descriptionMessage}}</p> <br>
    Lieu de RDV : {{ ride.meetingPlace}} <br>
    Date : {{ ride.meetingDatetime|date('d/m/Y H:i')}} <br>
    {% if duration %}
        Durée estimée : {{ duration }} <br>
    {% endif %}
    Rhytme : {{ride.rideType.label}} <br>
    Niveau Conseillé: {{ride.pilotLevel.label}} <br>
    {% for moto in ride.motorcycles %}
        Moto de {{ moto.user.pseudo }} : {{ moto.brand.name ?? '' }} {{ moto.type.label }} ({{ moto.displacement }} cm³){% if not loop.last %}, {% endif %}
    {% else %}
        Aucune
    {% endfor %}
    <br>
    
    {{ include('ride/_participation.html.twig', {ride: ride}) }}
    {{ include('ride/_like.html.twig', {ride: ride}) }}

<h2>Participants</h2>
<ul>
    {% for participant in ride.participants %}
        <li>
            {{ participant.pseudo }}
            {% if ride.user == app.user and participant != app.user and 'ROLE_ADMIN' not in participant.roles %}
                {# Strike (motif obligatoire) #}
                <form method="post" action="{{ path('app_ride_strike', {ride: ride.id, user: participant.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('strike_participant' ~ participant.id) }}">
                    <input type="text" name="reason" placeholder="Motif" required>
                    <button type="submit">Strike</button>
                </form>
                {# Exclure #}
                <form method="post" action="{{ path('app_ride_exclude', {ride: ride.id, user: participant.id}) }}"
                      onsubmit="return confirm('Exclure ce participant ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('exclude_participant' ~ participant.id) }}">
                    <button type="submit">Exclure</button>
                </form>
            {% endif %}
        </li>
    {% endfor %}
</ul>

<h2>Commentaires</h2>

{% for comment in ride.comments %}
    <div>
        <strong>{{ comment.user.pseudo }}</strong>
        <em>{{ comment.createdAt|date('d/m/Y H:i') }}</em>
        <p>{{ comment.message }}</p>

        {# bouton supprimer : auteur OU organisateur de la balade #}
        {% if comment.user == app.user or ride.user == app.user or is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}"
                  onsubmit="return confirm('Supprimer ce commentaire ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ comment.id) }}">
                <button type="submit">Supprimer</button>
            </form>
        {% endif %}
    </div>
{% else %}
    <p>Aucun commentaire pour l'instant.</p>
{% endfor %}

{% if ride.participants.contains(app.user)
      and ride.statut.value != 'canceled'
      and ride.meetingDatetime > date() %}
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Publier</button>
    {{ form_end(form) }}
{% endif %}
    
    {% if ride.user == app.user or is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_ride_edit', {id: ride.id}) }}">Gérer la balade</a> <br>
    {% endif %}

    <a href="{{ path('app_home') }}">Accueil</a>
{% endblock %}