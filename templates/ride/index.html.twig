{% extends 'base.html.twig' %}

{% block title %}Hello RideController!{% endblock %}

{% block body %}

<a href="{{ path('app_ride_new') }}">Créer une balade</a>

{{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Filtrer</button>
{{ form_end(form) }}
<p>{{ pagination.totalItems }} balade{{ pagination.totalItems > 1 ? 's' }} trouvée{{ pagination.totalItems > 1 ? 's' }}</p>

{% for ride in pagination.items %}
    <article>
        <h2><a href="{{ path('app_ride_show', {id: ride.id}) }}">{{ ride.name }}</a></h2>
        <p>{{ ride.meetingDatetime|date('d/m/Y H:i') }} — {{ ride.departmentCode }}</p>
        {% set organizerRideCount = organizerRideCounts[ride.user.id] %}
        <p>Organisateur : {{ ride.user.pseudo }} ({{ organizerRideCount }} balade{{ organizerRideCount > 1 ? 's' }} organisée{{ organizerRideCount > 1 ? 's' }})</p>
        <p>Statut : {{ include('ride/_status.html.twig', {ride: ride}) }} — Places restantes : {{ ride.capacity - (ride.participants|length) }}</p>
        {{ include('ride/_participation.html.twig', {ride: ride}) }}
    </article>
{% else %}
    <p>Aucune balade ne correspond à ta recherche.</p>
{% endfor %}
{{ include('ride/_pagination.html.twig', {pagination: pagination}) }}
{% endblock %}
