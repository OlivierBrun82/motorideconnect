{% extends 'base.html.twig' %}

{% block title %}Hello RideController!{% endblock %}

{% block body %}

{{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Filtrer</button>
{{ form_end(form) }}


{% for ride in rides %}
    <article>
        <h2><a href="{{ path('app_ride_show', {id: ride.id}) }}">{{ ride.name }}</a></h2>
        <p>{{ ride.meetingDatetime|date('d/m/Y H:i') }} — {{ ride.departmentCode }}</p>
        <p>Statut : {{ ride.statut.label }} — Places restantes : {{ ride.capacity - (ride.participants|length) }}</p>
    </article>
{% else %}
    <p>Aucune balade ne correspond à ta recherche.</p>
{% endfor %}

{% endblock %}
