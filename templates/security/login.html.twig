{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{# Pas de barre haute sur les ecrans d'auth : la marque la remplace #}
{% block header %}{% endblock %}

{% block body %}
    <div class="auth">
        {# La marque ramene a l'accueil, comme sur la plupart des sites #}
        <p class="auth-brand"><a href="{{ path('app_home') }}">MotoRide-Connect</a></p>

        <h1>Connexion</h1>

        {% if error %}
            <div class="flash-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <p class="text-muted">
                Tu es connecté en tant que {{ app.user.userIdentifier }}.
                <a href="{{ logout_path() }}">Déconnexion</a>
            </p>
        {% endif %}

        <form method="post">
            <div class="field">
                <label for="username">Adresse email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="input" autocomplete="email" required autofocus>
            </div>

            <div class="field">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="input" minlength="8" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary btn-block" type="submit">
                Se connecter
            </button>
        </form>

        <p class="auth-foot">
            Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>
        <p class="auth-foot text-muted">
            <a href="{{ path('app_legal') }}">Mentions légales</a>
        </p>
    </div>
{% endblock %}
