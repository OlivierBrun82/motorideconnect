{% extends 'base.html.twig' %}

{% block title %}{{ motorcycle.brand ? motorcycle.brand.name : 'Moto' }}{% endblock %}

{% block body %}
    <h1>{{ motorcycle.type.label }}</h1>

    {% if motorcycle.brand %}
        <p>Marque : {{ motorcycle.brand.name }}</p>
    {% endif %}

    <p>Cylindrée : {{ motorcycle.displacement }} cm³</p>

    {% if motorcycle.autonomy %}
        <p>Autonomie : {{ motorcycle.autonomy }} km</p>
    {% endif %}

    {% if motorcycle.photo %}
        <img src="{{ asset('uploads/motorcycles/' ~ motorcycle.photo) }}" alt="photo de la moto">
    {% endif %}

    {% if motorcycle.user == app.user %}
        <a href="{{ path('app_motorcycle_edit', {id: motorcycle.id}) }}">Modifier</a> <br>
    {% endif %}
    <a href="{{ path('app_motorcycle') }}">Retour au garage</a>
{% endblock %}