{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div class="auth">
        <p class="auth-brand"><a href="{{ path('app_home') }}">MotoRide-Connect</a></p>

        <h1>Mot de passe oublié</h1>

        {% for flash_error in app.flashes('danger') %}
            <div class="flash-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="flash-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <p class="text-muted">
            Indique ton adresse email, on t'envoie un lien pour choisir un nouveau mot de passe.
        </p>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}

            <button class="btn btn-primary btn-block" type="submit">
                Envoyer le lien de réinitialisation
            </button>
        {{ form_end(requestForm) }}

        <p class="auth-foot">
            <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </p>
    </div>
{% endblock %}
