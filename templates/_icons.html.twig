{# Icones au trait sur grille 24x24, style commun dans .icon (app.css) #}

{% macro home() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 10.5 L12 3 L21 10.5 V20 H3 Z"/>
        <path d="M9.5 20 V14 H14.5 V20"/>
    </svg>
{% endmacro %}

{% macro plusCircle() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5"/>
        <path d="M12 8 V16 M8 12 H16"/>
    </svg>
{% endmacro %}

{% macro magnifier() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"/>
        <path d="M15.5 15.5 L21 21"/>
    </svg>
{% endmacro %}

{% macro user() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="8" r="3.5"/>
        <path d="M4.5 20 C4.5 16.5 7.8 14.5 12 14.5 C16.2 14.5 19.5 16.5 19.5 20"/>
    </svg>
{% endmacro %}

{% macro arrowLeft() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 12 H5"/>
        <path d="M11 6 L5 12 L11 18"/>
    </svg>
{% endmacro %}

{% macro burger() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7 H20 M4 12 H20 M4 17 H20"/>
    </svg>
{% endmacro %}

{# Deux lobes en arc, deux flancs en courbe : le remplissage porte l'etat du like #}
{% macro heart() %}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 20.3 C6.5 15.6 3 12.6 3 9.4 A4.4 4.4 0 0 1 12 7.4 A4.4 4.4 0 0 1 21 9.4 C21 12.6 17.5 15.6 12 20.3 Z"/>
    </svg>
{% endmacro %}

{# Roue a rayons : illustration des etats vides, format 64px via .icon-large #}
{% macro wheel() %}
    <svg class="icon-large" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <circle cx="12" cy="12" r="2.5"/>
        <path d="M12 3 V9.5 M12 14.5 V21 M3 12 H9.5 M14.5 12 H21"/>
    </svg>
{% endmacro %}
