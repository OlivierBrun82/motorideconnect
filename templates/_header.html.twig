{# Barre haute, deux variantes : menu (defaut) ou retour si back est fourni #}
{% import '_icons.html.twig' as icon %}

{% set title = title|default('MotoRide-Connect') %}
{% set back = back|default(null) %}
{% set edit = edit|default(null) %}
{% set editLabel = editLabel|default('Modifier') %}

<header class="topbar">
    {% if back %}
        <a href="{{ back }}" class="topbar-action" aria-label="Retour">{{ icon.arrowLeft() }}</a>
    {% else %}
        <details class="menu">
            <summary class="topbar-action" aria-label="Ouvrir le menu">{{ icon.burger() }}</summary>
            <nav class="menu-panel" aria-label="Menu secondaire">
                {{ include('_menu.html.twig', {}, with_context = false) }}
            </nav>
        </details>
    {% endif %}

    <span class="topbar-title">{{ title }}</span>

    {# Sur grand ecran ce coin porte la marque, le titre de page etant deja dans le h1 #}
    <span class="topbar-title topbar-brand">MotoRide-Connect</span>

    {% if not back and app.user %}
        <a href="{{ path('app_profile') }}" class="topbar-action" aria-label="Mon profil">
            {% if app.user.avatar %}
                <img class="topbar-avatar" src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="">
            {% else %}
                {{ icon.user() }}
            {% endif %}
        </a>
    {% elseif edit %}
        {# Slot d'action droite, laisse vide en D2 faute de bouton partage sans JS #}
        <a href="{{ edit }}" class="topbar-action" aria-label="{{ editLabel }}">{{ icon.pencil() }}</a>
    {% else %}
        {# Espaceur : maintient le titre centre quand il n'y a pas d'action a droite #}
        <span class="topbar-action" aria-hidden="true"></span>
    {% endif %}
</header>
