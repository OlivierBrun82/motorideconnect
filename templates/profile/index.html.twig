{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icon %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <h1>Mon profil</h1>

    <div class="organizer">
        <span class="avatar avatar-lg">
            {% if app.user.avatar %}
                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="">
            {% else %}
                {{ icon.user() }}
            {% endif %}
        </span>
        <div class="organizer-info">
            <span class="organizer-name">{{ app.user.pseudo }}</span>
            <span>{{ app.user.email }}</span>
        </div>
    </div>

    {% if app.user.strikes|length > 0 %}
        <section class="card card-muted">
            <div class="section-head">
                <h2>Mes avertissements</h2>
                <span class="mono">{{ app.user.strikes|length }}</span>
            </div>

            {% if app.user.bannedDate %}
                <p class="notice">Ton compte est banni depuis le {{ app.user.bannedDate|date('d/m/Y') }}.</p>
            {% endif %}

            <ul class="plain-list">
                {% for strike in app.user.strikes %}
                    <li class="comment">
                        <span class="tile-label"><span class="mono">{{ strike.createdAt|date('d/m/Y H:i') }}</span></span>
                        <p>{{ strike.reason }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {{ form_start(profileForm) }}
        {{ form_widget(profileForm) }}
        <button type="submit" class="btn btn-primary btn-block">Enregistrer</button>
    {{ form_end(profileForm) }}

    {# form separe, JAMAIS imbrique dans celui du profil : les forms HTML imbriques sont interdits #}
    <details class="danger-zone">
        <summary>Supprimer mon compte</summary>

        <div class="danger-zone-body">
            <p class="notice">
                Cette action est irréversible. Tes données personnelles seront effacées et tu ne pourras
                plus te connecter. Tes balades à venir seront annulées et les participants prévenus par email.
            </p>

            <form method="post" action="{{ path('app_profile_delete') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">

                <div class="field">
                    <label for="delete_password">Confirme ton mot de passe</label>
                    <input type="password" id="delete_password" name="password" class="input" required autocomplete="current-password">
                    <p class="field-help">Le mot de passe est exigé en plus du jeton : le clic seul ne suffit pas.</p>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Supprimer mon compte</button>
            </form>
        </div>
    </details>
{% endblock %}
