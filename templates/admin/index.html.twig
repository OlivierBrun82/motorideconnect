{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <h1>Modération des membres</h1>

    <table>
        <thead>
            <tr>
                <th>Pseudo</th><th>Email</th><th>Strikes</th><th>Statut</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.pseudo }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.strikes|length }}</td>
                <td>{{ user.bannedDate ? 'Banni' : 'Actif' }}</td>
                <td>
                    {% if user == app.user %}
                        <em>C'est toi</em>
                    {% else %}
                        {# Infliger un strike (avec motif) #}
                        <form method="post" action="{{ path('app_admin_strike', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('strike' ~ user.id) }}">
                            <input type="text" name="reason" placeholder="Motif" required>
                            <button type="submit">Strike</button>
                        </form>

                        {# Bannir ou débannir selon l'état #}
                        {% if user.bannedDate %}
                            <form method="post" action="{{ path('app_admin_unban', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('unban' ~ user.id) }}">
                                <button type="submit">Débannir</button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_admin_ban', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ user.id) }}">
                                <button type="submit">Bannir</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>Marques de moto</h2>

    {# Ajout d'une marque absente du catalogue #}
    <form method="post" action="{{ path('app_admin_brand_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('brand_new') }}">
        <input type="text" name="name" placeholder="Nouvelle marque" maxlength="100" required>
        <button type="submit">Ajouter</button>
    </form>

    {# Choix de la marque à corriger : recharge /admin?brand=42 #}
    <form method="get" action="{{ path('app_admin') }}">
        <select name="brand"
                data-controller="symfony--ux-autocomplete--autocomplete"
                data-symfony--ux-autocomplete--autocomplete-no-results-found-text-value="Aucune marque trouvée">
            <option value="">Choisis une marque</option>
            {% for brand in brands %}
                <option value="{{ brand.id }}"{{ brand == selectedBrand ? ' selected' : '' }}>{{ brand.name }}</option>
            {% endfor %}
        </select>
        <button type="submit">Éditer</button>
    </form>

    {# Correction du nom de la marque sélectionnée #}
    {% if selectedBrand %}
        <form method="post" action="{{ path('app_admin_brand_edit', {id: selectedBrand.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('brand_edit' ~ selectedBrand.id) }}">
            <input type="text" name="name" value="{{ selectedBrand.name }}" maxlength="100" required>
            <button type="submit">Enregistrer</button>
        </form>
    {% endif %}
{% endblock %}